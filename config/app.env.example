# 固定支出配置（复制为 config/app.env 并 chmod 600，修改后 systemctl restart guding-zhichu）
# 登录密码哈希：pbkdf2_sha256$迭代次数$盐hex$哈希hex，用 `python3 server.py --hash` 生成
GZ_PASSWORD_HASH=
# 会话签名密钥（至少 32 字节），生成：python3 -c "import secrets;print(secrets.token_hex(32))"
GZ_SECRET=

# 扣款提醒的默认推送渠道（可选）。也可以不填，直接在页面「设置」里填写自己的机器人和 Bark
GZ_TZ=Asia/Shanghai
# Telegram：机器人 token 与接收消息的 chat_id
GZ_TG_TOKEN=
GZ_TG_CHAT=
# Bark：服务器地址（如 https://api.day.app 或自建 http://127.0.0.1:8080）与设备 key
GZ_BARK_BASE=
GZ_BARK_KEY=
